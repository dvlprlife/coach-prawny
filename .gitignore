# Dependencies
node_modules/

# Environment variables
# Vite inlines any VITE_-prefixed var into the client bundle at build time, so
# nothing secret should live here anyway — but recognition.serverUrl and any
# future backend credential would, and `*.local` alone does not cover a plain
# `.env`.
.env*
!.env.example

# Build outputs
dist/
dist-ssr/
build/

# Stockfish worker + wasm, copied out of node_modules by scripts/sync-engine.mjs
# (wired to prebuild/predev). Generated from the version pinned in
# package-lock.json, so committing them would just duplicate a dependency —
# ~7 MB per copy, and every future bump would add another permanent blob.
public/engine/

# Vite local overrides (vite.config.local.ts, .env.local, ...)
*.local

# Logs
*.log
npm-debug.log*
logs/

# Test coverage
coverage/
.nyc_output/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Claude Code (per-machine settings; agent definitions stay tracked)
.claude/settings.local.json

# Backup files
*.bak
*.backup
*.old

# Temporary files
*.tmp
.cache/

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
