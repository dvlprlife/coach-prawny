{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coach-prawny",
  "compatibility_date": "2026-07-24",
  "observability": {
    "enabled": true
  },
  "assets": {
    // NOTE: "single-page-application" serves index.html for ANY unmatched
    // path, with a 200. That is Cloudflare's default for a Vite SPA, but this
    // app has no client-side router, so nothing needs the fallback — and it
    // means a missing asset is masked rather than reported. Verified live:
    // /engine/does-not-exist.wasm returns 200 text/html. If the Stockfish
    // binaries ever failed to build into dist/, the app would fetch HTML
    // instead of wasm and fail confusingly. Removing this line restores real
    // 404s.
    "not_found_handling": "single-page-application"
  },
  // Per-branch preview URLs for pull requests (enable non-production branch
  // builds in the Workers Builds dashboard settings too).
  "preview_urls": true,
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
